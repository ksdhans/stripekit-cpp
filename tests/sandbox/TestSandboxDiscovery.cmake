# Check that CTest registers every sandbox fixture and rejects unknown filters.
execute_process(
    COMMAND "${SANDBOX_EXECUTABLE}" --list
    RESULT_VARIABLE list_result
    OUTPUT_VARIABLE test_list
    OUTPUT_STRIP_TRAILING_WHITESPACE
)
if(NOT list_result STREQUAL "0" OR test_list STREQUAL "")
    message(FATAL_ERROR "Could not list sandbox tests")
endif()
string(REPLACE "\r\n" "\n" test_list "${test_list}")
string(REPLACE "\n" ";" test_list "${test_list}")
set(expected_suites)
foreach(test IN LISTS test_list)
    if(NOT test MATCHES "^([A-Za-z_][A-Za-z0-9_]*)\\.[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid sandbox test name: ${test}")
    endif()
    list(APPEND expected_suites "${CMAKE_MATCH_1}")
endforeach()
list(REMOVE_DUPLICATES expected_suites)
list(SORT expected_suites)

execute_process(
    COMMAND "${CTEST_EXECUTABLE}" --test-dir "${BUILD_DIRECTORY}"
        -C "${TEST_CONFIGURATION}" -L sandbox --show-only=json-v1
    RESULT_VARIABLE discovery_result
    OUTPUT_VARIABLE discovery
    ERROR_VARIABLE discovery_error
)
if(NOT discovery_result STREQUAL "0")
    message(FATAL_ERROR "Could not discover sandbox groups: ${discovery_error}")
endif()
string(JSON group_count LENGTH "${discovery}" tests)
if(group_count EQUAL 0)
    message(FATAL_ERROR "CTest listed no sandbox groups")
endif()
math(EXPR last_group "${group_count} - 1")
set(discovered_suites)
set(logs)
foreach(index RANGE ${last_group})
    string(JSON name GET "${discovery}" tests ${index} name)
    if(NOT name MATCHES "^stripekit\\.sandbox\\.([A-Za-z_][A-Za-z0-9_]*)$")
        message(FATAL_ERROR "Invalid sandbox group: ${name}")
    endif()
    set(suite "${CMAKE_MATCH_1}")
    list(APPEND discovered_suites "${suite}")
    string(JSON command_length LENGTH "${discovery}" tests ${index} command)
    if(NOT command_length EQUAL 3)
        message(FATAL_ERROR "Invalid command for ${name}")
    endif()
    string(JSON command_executable GET "${discovery}" tests ${index} command 0)
    string(JSON command_flag GET "${discovery}" tests ${index} command 1)
    string(JSON command_suite GET "${discovery}" tests ${index} command 2)
    if(NOT command_executable STREQUAL SANDBOX_EXECUTABLE OR
       NOT command_flag STREQUAL "--suite" OR NOT command_suite STREQUAL suite)
        message(FATAL_ERROR "Invalid command for ${name}")
    endif()
    string(JSON property_count LENGTH "${discovery}" tests ${index} properties)
    math(EXPR last_property "${property_count} - 1")
    unset(serial)
    unset(timeout)
    unset(log)
    foreach(property_index RANGE ${last_property})
        string(JSON property GET "${discovery}" tests ${index} properties ${property_index} name)
        if(property STREQUAL "RUN_SERIAL")
            string(JSON serial GET "${discovery}" tests ${index} properties ${property_index} value)
        elseif(property STREQUAL "TIMEOUT")
            string(JSON timeout GET "${discovery}" tests ${index} properties ${property_index} value)
        elseif(property STREQUAL "ENVIRONMENT")
            string(JSON log GET "${discovery}" tests ${index} properties ${property_index} value 0)
        endif()
    endforeach()
    if(NOT serial OR NOT timeout EQUAL 900 OR
       NOT log MATCHES "^STRIPEKIT_TEST_PROGRESS_LOG=.+$")
        message(FATAL_ERROR "Invalid properties for ${name}")
    endif()
    list(APPEND logs "${log}")
endforeach()
list(SORT discovered_suites)
if(NOT discovered_suites STREQUAL expected_suites)
    message(FATAL_ERROR "CTest sandbox groups do not match the registered fixtures")
endif()
list(REMOVE_DUPLICATES logs)
list(LENGTH logs log_count)
if(NOT log_count EQUAL group_count)
    message(FATAL_ERROR "Sandbox groups must use separate progress logs")
endif()

foreach(filter IN ITEMS --suite StripeKitNonexistentSandboxFilter)
    if(filter STREQUAL "--suite")
        execute_process(COMMAND "${SANDBOX_EXECUTABLE}" --suite StripeKitNonexistentSandboxSuite
            RESULT_VARIABLE filter_result OUTPUT_QUIET ERROR_QUIET)
    else()
        execute_process(COMMAND "${SANDBOX_EXECUTABLE}" "${filter}"
            RESULT_VARIABLE filter_result OUTPUT_QUIET ERROR_QUIET)
    endif()
    if(filter_result STREQUAL "0")
        message(FATAL_ERROR "A nonexistent sandbox filter succeeded")
    endif()
endforeach()
