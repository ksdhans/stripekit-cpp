<%inc
#include "CheckoutDemoViewData.h"
%>
<%c++
auto data = @@.get<stripekit::examples::CheckoutDemoViewData>("data");
%>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StripeKit Checkout Demo</title>
    <style>
        :root {
            color-scheme: light;
            font-family: "Aptos", "Segoe UI", sans-serif;
            background: #f4efe6;
            color: #20242a;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at 18% 12%, rgba(36, 117, 98, 0.18), transparent 26rem),
                linear-gradient(135deg, #f8f2e8 0%, #e7f0ea 58%, #f5efe2 100%);
        }
        main { width: min(1120px, calc(100vw - 32px)); margin: 0 auto; padding: 36px 0 48px; }
        header { display: grid; gap: 8px; margin-bottom: 24px; }
        .eyebrow { color: #28715f; font-weight: 700; text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.08em; }
        h1, h2, h3, p { margin-top: 0; }
        h1 { font-family: "Iowan Old Style", Georgia, serif; font-size: clamp(2.3rem, 6vw, 5rem); line-height: 0.95; max-width: 760px; }
        h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: #49515a; }
        .layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr); gap: 18px; align-items: start; }
        .panel, .product, .events { background: rgba(255, 255, 255, 0.82); border: 1px solid #d6cbbc; border-radius: 8px; padding: 22px; box-shadow: 0 16px 40px rgba(44, 48, 53, 0.09); }
        .notice { border-color: #ce6e43; background: #fff5ea; color: #803d1f; font-weight: 700; }
        .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
        label { display: grid; gap: 6px; margin: 12px 0; font-size: 0.92rem; font-weight: 700; }
        input { width: 100%; font: inherit; padding: 11px 12px; border: 1px solid #b7aa98; border-radius: 6px; background: #fffefa; }
        button, .button { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; font: 800 0.95rem "Aptos", "Segoe UI", sans-serif; color: white; background: #1f6f5b; border: 0; border-radius: 6px; padding: 10px 14px; text-decoration: none; cursor: pointer; }
        button.secondary, .button.secondary { background: #334657; }
        code { overflow-wrap: anywhere; background: #eee5d8; border-radius: 5px; padding: 2px 5px; }
        .muted { color: #61707c; }
        .listener-status { margin: 14px 0 0; }
        .status { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
        .pill { border: 1px solid #cfc4b4; border-radius: 999px; padding: 6px 10px; background: #fffefa; font-size: 0.86rem; }
        .product { min-height: 260px; display: grid; align-content: space-between; background: linear-gradient(145deg, rgba(255,255,255,0.9), rgba(238,247,242,0.86)); }
        .price { font-family: "Iowan Old Style", Georgia, serif; font-size: 2.4rem; margin-bottom: 16px; }
        .trial-description { margin: 24px 0 8px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #ddd4c7; vertical-align: top; }
        th { color: #5c6871; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; }
        @media (max-width: 820px) { .layout, .grid { grid-template-columns: 1fr; } main { padding-top: 24px; } }
    </style>
</head>
<body>
<main>
    <header>
        <div class="eyebrow">StripeKit C++</div>
        <h1>Hosted Checkout with Drogon</h1>
        <p class="muted">A small native example for creating a customer, redirecting to Stripe Checkout, and receiving verified webhooks.</p>
    </header>

    <%c++ if(!data.notice.empty()) { %>
    <section class="panel notice">{% data.notice %}</section>
    <%c++ } %>

    <div class="layout">
        <section class="panel">
            <h2>Setup</h2>
            <p class="muted">{% data.configured_summary %}</p>
            <form method="post" action="/setup">
                <div class="grid">
                    <label>Stripe secret key
                        <input name="api_key" autocomplete="off" placeholder="sk_test_...">
                    </label>
                    <label>Existing recurring price id, optional
                        <input name="price_id" placeholder="price_..." value="{% data.price_id %}">
                    </label>
                </div>
                <div class="grid">
                    <label>Inline product name
                        <input name="product_name" value="{% data.product_name %}">
                    </label>
                    <label>Monthly amount
                        <input name="unit_amount" inputmode="numeric" value="<%c++ $$ << data.unit_amount; %>">
                    </label>
                </div>
                <label>Currency
                    <input name="currency" value="{% data.currency %}">
                </label>
                <label>Webhook signing secret
                    <input name="webhook_secret" autocomplete="off" placeholder="whsec_...">
                </label>
                <p class="muted">Leave credential fields blank to keep saved values.</p>
                <button type="submit">Save setup</button>
            </form>
            <div class="status">
                <span class="pill">Stripe CLI: <%c++ $$ << (data.stripe_cli_installed ? "installed" : "not found"); %></span>
                <span class="pill">Webhook endpoint: /webhook</span>
            </div>
            <p><code>stripe listen --all-snapshot --latest --forward-to http://127.0.0.1:<%c++ $$ << data.port; %>/webhook</code></p>
            <p class="muted">Listener log: <code>{% data.listener_log_path %}</code></p>
            <form method="post" action="/stripe-cli/start">
                <button class="secondary" type="submit" <%c++ if(data.cli_starting) { $$ << "disabled"; } %>>Start Stripe CLI listener</button>
            </form>
            <%c++ if(data.cli_starting) { %>
            <p class="muted listener-status">Waiting for the Stripe CLI listener signing secret.</p>
            <%c++ } %>
            <%c++ if(data.cli_started) { %>
            <%c++ if(data.has_webhook_secret) { %>
            <p class="muted listener-status">Listener is started and the webhook signing secret was captured automatically.</p>
            <%c++ } else { %>
            <p class="muted listener-status">Listener start was requested. If setup is still incomplete, check the listener log and paste the whsec value above.</p>
            <%c++ } %>
            <%c++ } %>
        </section>

        <section class="product">
            <div>
                <h2>Mock Sales Page</h2>
                <h3>Demo service membership</h3>
                <p class="price">$12<span class="muted"> / month</span></p>
                <p class="muted">The product is defined inline unless you provide an existing Price ID.</p>
                <p class="muted">Use test cards only, with a future expiry and a valid-format CVC.</p>
                <ul class="muted">
                    <li>Success: <code>4242 4242 4242 4242</code></li>
                    <li>Decline: <code>4000 0000 0000 0002</code></li>
                    <li>Always authenticate (3D Secure): <code>4000 0027 6000 3184</code></li>
                </ul>
                <p class="muted">See <a href="https://docs.stripe.com/testing">Stripe's test cards and expected outcomes</a>.</p>
            </div>
            <%c++ if(data.can_start_checkout) { %>
            <form method="post" action="/checkout">
                <label>Email
                    <input name="email" type="email" required placeholder="customer@example.com">
                </label>
                <button type="submit" name="trial" value="0">Continue to Checkout</button>
                <p class="trial-description">No charge today with the trial. A card is required; monthly billing starts
                    after 14 days unless canceled. Stripe Checkout shows the price and first billing date.</p>
                <button class="secondary" type="submit" name="trial" value="14">Start a 14-day free trial</button>
            </form>
            <%c++ } else { %>
            <p class="muted">Save a test secret key to enable Checkout.</p>
            <%c++ } %>
        </section>
    </div>

    <section class="events">
        <h2>Verified Webhooks</h2>
        <%c++ if(data.events.empty()) { %>
        <p class="muted">No verified webhook events received yet.</p>
        <%c++ } else { %>
        <table>
            <thead><tr><th>Event</th><th>Type</th><th>API version</th><th>Mode</th></tr></thead>
            <tbody>
            <%c++ for(auto iter = data.events.rbegin(); iter != data.events.rend(); ++iter) { %>
                <tr>
                    <td>{% iter->id %}</td>
                    <td>{% iter->type %}</td>
                    <td>{% iter->api_version %}</td>
                    <td><%c++ $$ << (iter->livemode ? "live" : "test"); %></td>
                </tr>
            <%c++ } %>
            </tbody>
        </table>
        <%c++ } %>
    </section>
</main>
</body>
</html>