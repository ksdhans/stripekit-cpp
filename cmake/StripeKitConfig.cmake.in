@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@STRIPEKIT_INSTALL_LIBSODIUM@ AND NOT TARGET StripeKit::libsodium)
    add_library(StripeKit::libsodium STATIC IMPORTED)
    set_target_properties(StripeKit::libsodium PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/stripekit/libsodium.a"
    )
endif()
@STRIPEKIT_CONFIG_LIBSODIUM@
find_dependency(jsoncpp CONFIG)
@STRIPEKIT_CONFIG_FIND_SQLITE@
@STRIPEKIT_CONFIG_FIND_DROGON@

# Drogon's filesystem finder restores an unset standard as an invalid empty value.
if(DEFINED CMAKE_CXX_STANDARD AND CMAKE_CXX_STANDARD STREQUAL "")
    unset(CMAKE_CXX_STANDARD)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/StripeKitTargets.cmake")
