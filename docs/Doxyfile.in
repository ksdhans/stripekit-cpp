PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"

OUTPUT_DIRECTORY       = @STRIPEKIT_DOXYGEN_OUTPUT_DIR@
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

INPUT                  = @STRIPEKIT_DOXYGEN_INPUT@
FILE_PATTERNS          = *.h *.md *.dox

EXAMPLE_PATH           = @CMAKE_CURRENT_SOURCE_DIR@/examples
EXAMPLE_RECURSIVE      = YES
IMAGE_PATH             = @CMAKE_CURRENT_SOURCE_DIR@/docs

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3

# The public API is documented in the headers; implementation files are not
# part of the reference.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Grouping via @defgroup drives the "Topics" navigation, which keeps the core
# API and the framework adapters in separate sections.
DISTRIBUTE_GROUP_DOC   = YES
GROUP_NESTED_COMPOUNDS = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
REPEAT_BRIEF           = YES

# StripeKit's file header comments use an @License line.
ALIASES                = "License=@par License:^^" \
                         "license=@par License:^^"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

# Coroutine and adapter headers pull in framework types that Doxygen does not
# need to resolve to document StripeKit's own API.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = STRIPEKIT_WITH_LIBSODIUM=1 \
                         STRIPEKIT_WITH_SQLITE3=1 \
                         DOXYGEN_SHOULD_SKIP_THIS

HAVE_DOT               = @STRIPEKIT_DOXYGEN_HAVE_DOT@
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
