{
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_path": "/usr/bin/clang-format-21",
    "C_Cpp.clang_format_style": "file",
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "svn.ignoreMissingSvnWarning": true,
    "chat.tools.terminal.autoApprove": {
        "pkg-config": true,
        "true": true,
        "cmake": true,
        "ctest": true,
        "./build/tests/stripekit_unit_tests": true,
        "./build/tests/stripekit_integration_tests": true,
        "./build/bin/stripekit_sandbox_tests": true,
        "doxygen": true,
        "./build/bin/stripekit_integration_tests": true,
        "printf": true
    }
}